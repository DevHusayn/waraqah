{
    "name": "waraqah",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/mobile"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
        "generate:mobile-icons": "node scripts/generate-mobile-icons.mjs",
        "test": "npm run test:shared && npm run test:backend",
        "test:shared": "node --test packages/shared/tests/**/*.test.js",
        "test:backend": "npm run test --prefix ../InvoicePro-backend",
        "mobile": "npm run start -w mobile",
        "mobile:android": "npm run android -w mobile",
        "mobile:ios": "npm run ios -w mobile"
    },
    "dependencies": {
        "@react-oauth/google": "^0.13.5",
        "@sentry/react": "^10.62.0",
        "@tanstack/react-query": "^5.101.4",
        "@waraqah/shared": "*",
        "date-fns": "^3.0.0",
        "jspdf": "^3.0.4",
        "jspdf-autotable": "^5.0.8",
        "lucide-react": "^0.300.0",
        "pdf-lib": "^1.17.1",
        "posthog-js": "^1.414.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.30.4"
    },
    "devDependencies": {
        "@fontsource/bodoni-moda": "^5.3.0",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.23",
        "postcss": "^8.5.6",
        "sharp": "^0.35.3",
        "tailwindcss": "^3.4.19",
        "vite": "^5.0.8",
        "vite-plugin-pwa": "^1.3.0"
    }
}
